+    #[test]
+    fn clone_with_context_of_uses_the_template_context() {
+        let variables = Arc::new(vec![symbol!("x").into(), symbol!("y").into()]);
+        let p = parse!("x^2*y+3*y").to_polynomial::<_, u8>(&Z, variables);
+        let template = p.zero_with_new_context();
+        assert!(!Arc::ptr_eq(&p.context, &template.context));
+        assert!(!Arc::ptr_eq(p.variables(), template.variables()));
+        let q = p.clone_with_context_of(&template);
+        assert!(Arc::ptr_eq(&q.context, &template.context));
+        assert_eq!(q, p);
+
+        let split = q.to_multivariate_polynomial_list(&[0], true);
+        assert_eq!(split, p.to_multivariate_polynomial_list(&[0], true));
+        assert_eq!(split.len(), 2);
+    }
