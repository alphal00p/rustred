+    #[test]
+    fn heap_pow_many_variable_square_matches_native_multiplication() {
+        let variables = Arc::new((0..22).map(super::PolyVariable::Temporary).collect());
+        let mut affine = MultivariatePolynomial::<_, u32>::new(&Q, None, variables);
+        for axis in 0..22 {
+            let mut exponents = vec![0; 22];
+            exponents[axis] = 1;
+            affine.append_monomial(crate::domains::rational::Rational::one(), &exponents);
+        }
+        let expected = &affine * &affine;
+        assert_eq!(expected.nterms(), 253);
+        assert_eq!(affine.pow(2), expected);
+    }
+
+    #[test]
+    fn heap_pow_mixed_radix_roundtrips_wide_nonuniform_and_zero_digits() {
+        for (exponents, radices_rev, expected) in [
+            (vec![7_u32, 0, 5, 1], vec![3, 8, 1, 9], Integer::from(184)),
+            // The place value fits u32; multiplying its digit does not.
+            (
+                vec![2, 0, 0],
+                vec![65536, 32768, 3],
+                Integer::from(2).pow(32),
+            ),
+            (
+                vec![7, 0],
+                vec![1_usize << 30, 8],
+                Integer::from(7) * Integer::from(2).pow(30),
+            ),
+            // The whole packed exponent also exceeds u128.
+            (
+                vec![65535; 12],
+                vec![65536; 12],
+                Integer::from(2).pow(192) - 1,
+            ),
+        ] {
+            let encoded = super::heap_power_encode_exponents(&exponents, &radices_rev);
+            assert_eq!(encoded, expected);
+            let mut decoded = vec![0_u32; exponents.len()];
+            super::heap_power_decode_exponents(encoded, &radices_rev, &mut decoded);
+            assert_eq!(decoded, exponents);
+        }
+    }
+
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn heap_pow_decoder_keeps_an_individual_radix_wider_than_u32() {
