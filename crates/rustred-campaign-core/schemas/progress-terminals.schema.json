{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress-terminals.schema.json",
  "title": "Progress file CDIR/progress/terminals.json (every declared terminal per node; preferred / other)",
  "description": "AS BUILT: rustred_campaign::progress::derive (\"file\": \"terminals\"); ledger-and-progress.md 9.",
  "x-rr-names": [
    "rustred.campaign.progress.v1"
  ],
  "x-rr-select": {
    "file": "terminals"
  },
  "x-rr-owner": "I-LEDGER (co-signer C-DASH)",
  "x-rr-freeze": "M0",
  "allOf": [
    {
      "$ref": "progress-common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "declared",
    "nodes"
  ],
  "properties": {
    "file": {
      "const": "terminals"
    },
    "declared": {
      "$ref": "common.schema.json#/$defs/u64"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "report",
          "terminals"
        ],
        "properties": {
          "report": {
            "type": "object",
            "required": [
              "preferred_used",
              "preferred_listed",
              "preferred_not_needed",
              "other",
              "counted",
              "bound"
            ]
          },
          "terminals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "keys",
                "keyset",
                "preferred",
                "counted"
              ]
            }
          }
        }
      }
    }
  }
}
