{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress-heartbeat.schema.json",
  "title": "Progress file CDIR/progress/heartbeat.json (VOLATILE: rewritten on every write, even when nothing changed)",
  "description": "AS BUILT: rustred_campaign::progress::derive (\"file\": \"heartbeat\"); ledger-and-progress.md 9.",
  "x-rr-names": [
    "rustred.campaign.progress.v1"
  ],
  "x-rr-select": {
    "file": "heartbeat"
  },
  "x-rr-owner": "I-LEDGER (co-signer C-DASH)",
  "x-rr-freeze": "M0",
  "allOf": [
    {
      "$ref": "progress-common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "supervisor"
  ],
  "properties": {
    "file": {
      "const": "heartbeat"
    },
    "supervisor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "heartbeat_utc",
            "started_utc",
            "pid",
            "host",
            "grace_left_s",
            "stopping"
          ]
        }
      ]
    }
  }
}
