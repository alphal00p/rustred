{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-record.schema.json",
  "title": "One line of the ledger of record (CDIR/ledger/segment-NNNNNN.jsonl)",
  "description": "AS BUILT: rustred_campaign::ledger::Record (interfaces/ledger-and-progress.md 2-3). Closed list of kinds; the ledger is never read tolerantly (unknown kinds and fields refused). Canonical bytes = the line as written; `prev` = BLAKE3 of the previous line's bytes (64 zeros for seq 1).",
  "x-rr-names": ["rustred.campaign.ledger.v1"],
  "x-rr-owner": "I-LEDGER",
  "x-rr-struct": "rustred_campaign::ledger::Record",
  "x-rr-freeze": "M0",
  "type": "object",
  "required": ["schema", "seq", "utc", "prev", "event"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rustred.campaign.ledger.v1"},
    "seq": {"type": "integer", "minimum": 1},
    "utc": {"$ref": "common.schema.json#/$defs/utc_ms"},
    "prev": {"$ref": "common.schema.json#/$defs/blake3"},
    "event": {"$ref": "#/$defs/event"}
  },
  "$defs": {
    "str": {"type": "string"},
    "strn": {"type": ["string", "null"]},
    "u64": {"$ref": "common.schema.json#/$defs/u64"},
    "u32": {"$ref": "common.schema.json#/$defs/u32"},
    "fileref": {"$ref": "common.schema.json#/$defs/fileref"},
    "fileref_or_null": {"$ref": "common.schema.json#/$defs/fileref_or_null"},
    "reason_body": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"reason": {"type": "string"}}},
    "event": {
      "type": "object",
      "required": ["kind", "body"],
      "additionalProperties": false,
      "properties": {
        "body": {"type": "object"},
        "kind": {"enum": ["campaign_created", "campaign", "supervisor_started", "lock_takeover", "recovery", "segment_opened", "input_registered", "evidence_imported", "node_registered", "rule_economy", "node", "item_created", "item", "job_queued", "job", "intent", "done", "job_progress", "note"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "campaign_created"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/campaign_created"}}}},
        {"if": {"properties": {"kind": {"const": "campaign"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/campaign"}}}},
        {"if": {"properties": {"kind": {"const": "supervisor_started"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/supervisor_started"}}}},
        {"if": {"properties": {"kind": {"const": "lock_takeover"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/lock_takeover"}}}},
        {"if": {"properties": {"kind": {"const": "recovery"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/recovery"}}}},
        {"if": {"properties": {"kind": {"const": "segment_opened"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/segment_opened"}}}},
        {"if": {"properties": {"kind": {"const": "input_registered"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/input_registered"}}}},
        {"if": {"properties": {"kind": {"const": "evidence_imported"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/evidence_imported"}}}},
        {"if": {"properties": {"kind": {"const": "node_registered"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/node_registered"}}}},
        {"if": {"properties": {"kind": {"const": "rule_economy"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/rule_economy"}}}},
        {"if": {"properties": {"kind": {"const": "node"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/node"}}}},
        {"if": {"properties": {"kind": {"const": "item_created"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/item_created"}}}},
        {"if": {"properties": {"kind": {"const": "item"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/item"}}}},
        {"if": {"properties": {"kind": {"const": "job_queued"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/job_queued"}}}},
        {"if": {"properties": {"kind": {"const": "job"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/job"}}}},
        {"if": {"properties": {"kind": {"const": "intent"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/intent"}}}},
        {"if": {"properties": {"kind": {"const": "done"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/done"}}}},
        {"if": {"properties": {"kind": {"const": "job_progress"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/job_progress"}}}},
        {"if": {"properties": {"kind": {"const": "note"}}}, "then": {"properties": {"body": {"$ref": "#/$defs/note"}}}}
      ]
    },
    "campaign_created": {"type": "object", "required": ["campaign_id", "spec_blake3", "terminal_bound"], "additionalProperties": false,
      "properties": {"campaign_id": {"$ref": "common.schema.json#/$defs/id"}, "spec_blake3": {"$ref": "common.schema.json#/$defs/blake3"}, "terminal_bound": {"$ref": "#/$defs/u32"}}},
    "campaign": {"type": "object", "required": ["ev", "reason"], "additionalProperties": false,
      "properties": {"ev": {"enum": ["start", "run", "drain", "stop", "finish"]}, "reason": {"type": "string"}}},
    "identity": {"type": "object", "required": ["pid", "start_ticks", "boot_id", "host"], "additionalProperties": false,
      "properties": {"pid": {"$ref": "#/$defs/u32"}, "start_ticks": {"$ref": "#/$defs/u64"}, "boot_id": {"type": "string"}, "host": {"type": "string"}}},
    "supervisor_started": {"type": "object", "required": ["identity", "argv", "version", "lock_token"], "additionalProperties": false,
      "properties": {"identity": {"$ref": "#/$defs/identity"}, "argv": {"type": "array", "items": {"type": "string"}}, "version": {"type": "string"}, "lock_token": {"type": "string"}}},
    "dead_reason": {"anyOf": [
      {"const": "pid_absent"},
      {"type": "object", "required": ["start_time_differs"], "additionalProperties": false, "properties": {"start_time_differs": {"type": "object", "required": ["now"], "additionalProperties": false, "properties": {"now": {"$ref": "#/$defs/u64"}}}}},
      {"type": "object", "required": ["boot_id_differs"], "additionalProperties": false, "properties": {"boot_id_differs": {"type": "object", "required": ["now"], "additionalProperties": false, "properties": {"now": {"type": "string"}}}}}
    ]},
    "lock_takeover": {"type": "object", "required": ["previous", "reason", "orphans"], "additionalProperties": false,
      "properties": {"previous": {"$ref": "lock.schema.json"}, "reason": {"$ref": "#/$defs/dead_reason"}, "orphans": {"type": "array", "items": {"$ref": "#/$defs/u32"}}}},
    "recovery": {"type": "object", "required": ["segment", "last_good_seq", "truncated_bytes", "saved_as", "detail"], "additionalProperties": false,
      "properties": {"segment": {"$ref": "#/$defs/u32"}, "last_good_seq": {"$ref": "#/$defs/u64"}, "truncated_bytes": {"$ref": "#/$defs/u64"}, "saved_as": {"$ref": "#/$defs/strn"}, "detail": {"type": "string"}}},
    "segment_opened": {"type": "object", "required": ["index", "previous_blake3", "snapshot_seq"], "additionalProperties": false,
      "properties": {"index": {"$ref": "#/$defs/u32"}, "previous_blake3": {"$ref": "common.schema.json#/$defs/blake3"}, "snapshot_seq": {"$ref": "#/$defs/u64"}}},
    "input_registered": {"type": "object", "required": ["input", "role", "path", "bytes", "blake3"], "additionalProperties": false,
      "properties": {"input": {"$ref": "common.schema.json#/$defs/id"}, "role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "bytes": {"$ref": "#/$defs/u64"}, "blake3": {"$ref": "common.schema.json#/$defs/blake3"}}},
    "evidence_imported": {"type": "object", "required": ["evidence", "producer", "description", "files"], "additionalProperties": false,
      "properties": {"evidence": {"$ref": "common.schema.json#/$defs/id"}, "producer": {"type": "string"}, "description": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/$defs/fileref"}}}},
    "node_registered": {"type": "object", "required": ["node", "inputs", "terminal_bound", "spec_box"], "additionalProperties": false,
      "properties": {"node": {"$ref": "common.schema.json#/$defs/id"}, "inputs": {"type": "array", "items": {"type": "string"}}, "terminal_bound": {"type": ["integer", "null"], "minimum": 0}, "spec_box": {"$ref": "#/$defs/strn"}}},
    "rule_economy": {"type": "object", "required": ["item", "economy"], "additionalProperties": false,
      "properties": {"item": {"type": "string"}, "economy": {"$ref": "common.schema.json#/$defs/economy"}}},
    "blockers": {"type": "object", "required": ["faces", "loci", "keys", "list"], "additionalProperties": false,
      "properties": {"faces": {"$ref": "#/$defs/u64"}, "loci": {"$ref": "#/$defs/u64"}, "keys": {"$ref": "#/$defs/u64"}, "list": {"$ref": "#/$defs/fileref_or_null"}}},
    "node": {"type": "object", "required": ["node", "ev"], "additionalProperties": false,
      "properties": {"node": {"type": "string"}, "ev": {"$ref": "#/$defs/node_ev"}}},
    "node_ev": {"type": "object", "required": ["ev"],
      "properties": {"ev": {"enum": ["start", "closure_result", "attempt_ended", "fall_back_to_box", "declare_open", "declare_closed", "declare_certified", "reopen", "mark_stale"]}},
      "allOf": [
        {"if": {"properties": {"ev": {"enum": ["start", "declare_closed", "declare_certified"]}}}, "then": {"additionalProperties": false, "properties": {"ev": true}}},
        {"if": {"properties": {"ev": {"const": "closure_result"}}}, "then": {"required": ["round", "defect_keys", "closure_keys", "rules_used", "rules_total", "keyset"], "additionalProperties": false,
          "properties": {"ev": true, "round": {"$ref": "#/$defs/u32"}, "defect_keys": {"$ref": "#/$defs/u64"}, "closure_keys": {"$ref": "#/$defs/u64"}, "rules_used": {"type": ["integer", "null"], "minimum": 0}, "rules_total": {"type": ["integer", "null"], "minimum": 0}, "keyset": {"$ref": "#/$defs/fileref_or_null"}}}},
        {"if": {"properties": {"ev": {"const": "attempt_ended"}}}, "then": {"required": ["blockers", "reason"], "additionalProperties": false, "properties": {"ev": true, "blockers": {"$ref": "#/$defs/blockers"}, "reason": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "fall_back_to_box"}}}, "then": {"required": ["box_id"], "additionalProperties": false, "properties": {"ev": true, "box_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"ev": {"enum": ["declare_open", "reopen", "mark_stale"]}}}, "then": {"required": ["reason"], "additionalProperties": false, "properties": {"ev": true, "reason": {"type": "string"}}}}
      ]},
    "item_created": {"type": "object", "required": ["item", "node", "kind", "rung", "parent", "inputs", "label", "weight"], "additionalProperties": false,
      "properties": {"item": {"$ref": "common.schema.json#/$defs/id"}, "node": {"type": "string"}, "kind": {"type": "string", "minLength": 1}, "rung": {"$ref": "common.schema.json#/$defs/rung"}, "parent": {"$ref": "#/$defs/strn"}, "inputs": {"type": "array", "items": {"type": "string"}}, "label": {"type": "string"}, "weight": {"$ref": "#/$defs/u64"}}},
    "item": {"type": "object", "required": ["item", "ev"], "additionalProperties": false,
      "properties": {"item": {"type": "string"}, "ev": {"$ref": "#/$defs/item_ev"}}},
    "accept_source": {"oneOf": [
      {"type": "object", "required": ["from", "job", "attempt", "table_blake3"], "additionalProperties": false, "properties": {"from": {"const": "job"}, "job": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "table_blake3": {"$ref": "common.schema.json#/$defs/blake3"}}},
      {"type": "object", "required": ["from", "evidence"], "additionalProperties": false, "properties": {"from": {"const": "evidence"}, "evidence": {"type": "string"}}}
    ]},
    "retirement_proof": {"type": "object", "required": ["kind"],
      "properties": {"kind": {"enum": ["empty_domain", "fully_shadowed", "replaced_by", "dispatch_order_change", "regeneration", "box_closure_pass"]}},
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["empty_domain", "fully_shadowed", "replaced_by", "dispatch_order_change"]}}}, "then": {"required": ["proof"], "additionalProperties": false, "properties": {"kind": true, "proof": {"$ref": "#/$defs/fileref"}}}},
        {"if": {"properties": {"kind": {"const": "regeneration"}}}, "then": {"required": ["table", "proof"], "additionalProperties": false, "properties": {"kind": true, "table": {"$ref": "#/$defs/fileref"}, "proof": {"$ref": "#/$defs/fileref"}}}},
        {"if": {"properties": {"kind": {"const": "box_closure_pass"}}}, "then": {"required": ["closure"], "additionalProperties": false, "properties": {"kind": true, "closure": {"$ref": "#/$defs/fileref"}}}}
      ]},
    "item_ev": {"type": "object", "required": ["ev"],
      "properties": {"ev": {"enum": ["start", "produce", "accept", "upgrade", "reject", "escalate", "requeue", "propose_terminal", "declare_terminal", "mark_stale", "reopen", "retire"]}},
      "allOf": [
        {"if": {"properties": {"ev": {"const": "start"}}}, "then": {"required": ["job"], "additionalProperties": false, "properties": {"ev": true, "job": {"$ref": "#/$defs/strn"}}}},
        {"if": {"properties": {"ev": {"const": "produce"}}}, "then": {"required": ["job", "attempt", "table"], "additionalProperties": false, "properties": {"ev": true, "job": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "table": {"$ref": "#/$defs/fileref"}}}},
        {"if": {"properties": {"ev": {"const": "accept"}}}, "then": {"required": ["rule", "level", "record", "source", "elided"], "additionalProperties": false, "properties": {"ev": true, "rule": {"type": "string", "minLength": 1}, "level": {"$ref": "common.schema.json#/$defs/evidence_level"}, "record": {"$ref": "#/$defs/fileref"}, "source": {"$ref": "#/$defs/accept_source"}, "elided": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "upgrade"}}}, "then": {"required": ["level", "evidence"], "additionalProperties": false, "properties": {"ev": true, "level": {"$ref": "common.schema.json#/$defs/evidence_level"}, "evidence": {"$ref": "#/$defs/fileref"}}}},
        {"if": {"properties": {"ev": {"enum": ["reject", "requeue", "propose_terminal", "reopen"]}}}, "then": {"required": ["reason"], "additionalProperties": false, "properties": {"ev": true, "reason": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "escalate"}}}, "then": {"required": ["to", "reason"], "additionalProperties": false, "properties": {"ev": true, "to": {"$ref": "common.schema.json#/$defs/rung"}, "reason": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "declare_terminal"}}}, "then": {"required": ["count", "keys", "reason"], "additionalProperties": false, "properties": {"ev": true, "count": {"$ref": "#/$defs/u32"}, "keys": {"$ref": "#/$defs/fileref_or_null"}, "reason": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "mark_stale"}}}, "then": {"required": ["input"], "additionalProperties": false, "properties": {"ev": true, "input": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "retire"}}}, "then": {"required": ["rule", "proof", "superseded_by"], "additionalProperties": false, "properties": {"ev": true, "rule": {"type": "string"}, "proof": {"$ref": "#/$defs/retirement_proof"}, "superseded_by": {"$ref": "#/$defs/strn"}}}}
      ]},
    "job_queued": {"type": "object", "required": ["job", "item", "rung", "kind", "spec_blake3", "binary", "reserved_bytes"], "additionalProperties": false,
      "properties": {"job": {"$ref": "common.schema.json#/$defs/id"}, "item": {"type": "string"}, "rung": {"$ref": "common.schema.json#/$defs/rung"}, "kind": {"type": "string"}, "spec_blake3": {"$ref": "common.schema.json#/$defs/blake3"}, "binary": {"type": "string"}, "reserved_bytes": {"$ref": "#/$defs/u64"}}},
    "job": {"type": "object", "required": ["job", "attempt", "ev"], "additionalProperties": false,
      "properties": {"job": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "ev": {"$ref": "#/$defs/job_ev"}}},
    "job_ev": {"type": "object", "required": ["ev"],
      "properties": {"ev": {"enum": ["launch", "started", "finished", "interrupt", "lose", "requeue", "retry", "cancel"]}},
      "allOf": [
        {"if": {"properties": {"ev": {"const": "launch"}}}, "then": {"required": ["run_dir", "cpus", "reserved_bytes"], "additionalProperties": false, "properties": {"ev": true, "run_dir": {"type": "string"}, "cpus": {"type": "array", "items": {"$ref": "#/$defs/u32"}}, "reserved_bytes": {"$ref": "#/$defs/u64"}}}},
        {"if": {"properties": {"ev": {"const": "started"}}}, "then": {"required": ["pid", "start_ticks", "boot_id"], "additionalProperties": false, "properties": {"ev": true, "pid": {"$ref": "#/$defs/u32"}, "start_ticks": {"$ref": "#/$defs/u64"}, "boot_id": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "finished"}}}, "then": {"required": ["class", "exit_code", "signal", "sealed_output", "outcome", "cpu_ms", "wall_ms", "peak_rss_bytes", "time_decided"], "additionalProperties": false,
          "properties": {"ev": true, "class": {"$ref": "common.schema.json#/$defs/finish_class"}, "exit_code": {"type": ["integer", "null"]}, "signal": {"type": ["integer", "null"]}, "sealed_output": {"$ref": "#/$defs/fileref_or_null"}, "outcome": {"$ref": "#/$defs/fileref_or_null"}, "cpu_ms": {"$ref": "#/$defs/u64"}, "wall_ms": {"$ref": "#/$defs/u64"}, "peak_rss_bytes": {"$ref": "#/$defs/u64"}, "time_decided": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"enum": ["interrupt", "lose", "requeue", "retry", "cancel"]}}}, "then": {"required": ["reason"], "additionalProperties": false, "properties": {"ev": true, "reason": {"type": "string"}}}}
      ]},
    "intent": {"type": "object", "required": ["op", "action", "target"], "additionalProperties": false,
      "properties": {"op": {"type": "string", "minLength": 1}, "action": {"type": "string"}, "target": {"type": "string"}}},
    "done": {"type": "object", "required": ["op", "result"], "additionalProperties": false,
      "properties": {"op": {"type": "string", "minLength": 1}, "result": {"$ref": "#/$defs/fileref_or_null"}}},
    "job_progress": {"type": "object", "required": ["job", "attempt", "counters"], "additionalProperties": false,
      "properties": {"job": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "counters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/u64"}}}},
    "note": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}}}
  }
}
